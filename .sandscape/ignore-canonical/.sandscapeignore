# Excluded from Sandscape uploads but kept on disk / in git.
# Same syntax as .gitignore. The Sandscape CLI honors BOTH this file and
# .gitignore. Everything NOT ignored round-trips to the platform verbatim and is
# served as a static bundle, so the rule of thumb is: keep exactly what the game
# fetches at runtime (index.html + js/ + assets/), drop everything that is only
# used offline on a developer's machine.

# --- Local dev servers + launchers (Sandscape hosts the bundle statically) ---
serve.py
Start-Server.bat
start-server.command
__pycache__/

# --- Offline asset-baking tools (FBX->GLB converters, reload/slide/crouch bakers).
# These are standalone browser utilities that pull three r160 from unpkg — the ONLY
# remaining external-CDN references in the tree, and never loaded by the game. ---
tools/

# --- Docs / project metadata — not game content, not fetched at runtime. ---
docs/
README.md
package.json

# --- In-game UE exporter OUTPUT (produced by the P key; regenerated on demand). ---
level_ue.glb
mechanics.json

# --- Oversized RAW source model kept on disk but never loaded at runtime. The game uses
# Sandscape_Liz_decimated.glb (6 MB); this is the pre-decimation Tripo export (100 MB) and
# exceeds Sandscape's 50 MB/file limit anyway. ---
assets/characters/Sandscape_Liz.glb

# --- Vortex Blaster (player weapon): the game ships ONLY the compressed SK_VortexBlaster.glb
# (~1.6 MB, WebP). The 10.8 MB source FBX and the ~20 MB uncompressed intermediate GLB are
# offline-only inputs to tools/vortex_fbx_to_glb.html + tools/compress_vortex.mjs — kept on
# disk for regeneration but never fetched at runtime. ---
assets/guns/New/SK_VortexBlaster.fbx
assets/guns/New/SK_VortexBlaster_raw.glb

# --- World props (art pass): the game ships ONLY the compressed set in assets/World/props/
# (~23 MB total, WebP + meshopt-simplified). The raw Meshy sources in assets/World/meshy_batch/
# are ~600 MB (20 x 15-49 MB) — over the 500 MB/push limit and never fetched at runtime; they are
# offline-only inputs to tools/compress_props.mjs, kept on disk (Git LFS) for regeneration. ---
assets/World/meshy_batch/
# The summit citadel ships as the compressed assets/World/props/Citadel.glb (~1.2 MB); this is the
# 15 MB raw Meshy source (offline input to tools/compress_citadel.mjs).
assets/World/Citadel_0723213948_texture.glb

# --- Local project archive (815 MB snapshot of the tree) — offline only, and far over
# Sandscape's 50 MB/file and 500 MB/push limits. ---
/TPS.zip

# --- Title key art: the game ships ONLY assets/ui/title_art.webp (~190 KB). This is the raw
# 2.2 MB PNG export, kept on disk as the regeneration input to tools/compress_titleart.py. ---
assets/ui/title_art_src.png

# --- VCS / tool dotfiles + CLI scratch. The server refuses hidden + tool-managed paths outright
# ("not a syncable project path"). NOTE: the PROD project still STORES .gitignore/.sandscapeignore
# from its original import, so every prod `pull` overwrites these two files with those stale copies
# — restore them before pushing (canonical copy: .sandscape/ignore-canonical/). ---
/.gitattributes
CLAUDE.md.sandscape.bak
/.gitignore
/.sandscapeignore
/.agents/
/.claude/

# --- Editor / OS cruft ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
